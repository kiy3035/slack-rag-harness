        <mxCell id="v-7" value="&lt;div style=&quot;font-size:11px;color:#475569;line-height:1.45&quot;&gt;Broker 호출은 DB 트랜잭션 밖에서 수행하고 성공 확인 뒤 상태를 확정한다.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1;dashed=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="640" y="600" width="315" height="72" as="geometry" />
        </mxCell>
        <mxCell id="consume" value="&lt;div style=&quot;font-size:11px;font-weight:700;color:#7C3AED;letter-spacing:0.4px&quot;&gt;RABBIT CONSUMER&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:700;color:#0F172A;margin-top:4px&quot;&gt;메시지 수신·계약 검증&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#475569;line-height:1.45;margin-top:6px&quot;&gt;prefetch=1 · 잘못된 Payload는 DLQ&lt;br&gt;저장 완료 후에만 ACK&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;dashed=0;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;spacingTop=8;fontColor=#0F172A;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1090" y="180" width="205" height="135" as="geometry" />
