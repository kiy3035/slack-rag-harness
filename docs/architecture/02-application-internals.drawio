        </mxCell>
        <mxCell id="v-6" value="&lt;div style=&quot;font-size:11px;color:#475569;line-height:1.45&quot;&gt;T1 · 접수 트랜잭션&lt;br&gt;ai_job INSERT와 job_outbox INSERT가 원자적&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1;dashed=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
