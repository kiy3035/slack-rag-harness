        <mxCell id="workerclaim" value="&lt;div style=&quot;font-size:11px;font-weight:700;color:#15803D;letter-spacing:0.4px&quot;&gt;CONDITIONAL UPDATE&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:700;color:#0F172A;margin-top:4px&quot;&gt;Job 멱등 선점&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#475569;line-height:1.45;margin-top:6px&quot;&gt;RECEIVED/QUEUED → PROCESSING&lt;br&gt;영향 행 수로 선점 판정&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;dashed=0;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;spacingTop=8;fontColor=#0F172A;shadow=1;" vertex="1" parent="1">
