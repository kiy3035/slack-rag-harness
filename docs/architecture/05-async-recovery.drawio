        <mxCell id="v-5" value="&lt;div style=&quot;font-size:11px;color:#475569;line-height:1.45&quot;&gt;Outbox row는 job_id UNIQUE이며 새 row를 계속 만들지 않고 기존 row를 다시 연다.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1;dashed=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
