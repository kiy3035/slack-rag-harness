          <mxGeometry x="525" y="180" width="190" height="118" as="geometry" />
        </mxCell>
        <mxCell id="queued" value="&lt;div style=&quot;font-size:14px;font-weight:700;color:#0F172A&quot;&gt;QUEUED + SENT&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#475569;margin-top:4px;line-height:1.35&quot;&gt;Broker가 메시지를 보관&lt;/div&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.5;align=center;verticalAlign=middle;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
