# 로컬 개발 전용 예시 값이며 운영 Secret을 저장하지 않는다.
POSTGRES_DB=rag_harness
POSTGRES_USER=rag_harness
POSTGRES_PASSWORD=local_dev_password
POSTGRES_PORT=5432

RABBITMQ_USER=rag_harness
RABBITMQ_PASSWORD=local_dev_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

API_PORT=8000
ENABLE_LOCAL_EVENTS=true
DATABASE_URL=postgresql+asyncpg://rag_harness:local_dev_password@localhost:5432/rag_harness
RABBITMQ_URL=amqp://rag_harness:local_dev_password@localhost:5672/

# 실제 Slack 값은 로컬 .env에만 입력하고 저장소에 커밋하지 않는다.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_TIMESTAMP_TOLERANCE_SECONDS=300

