# 로컬 개발 전용 예시 값이며 운영 Secret을 저장하지 않는다.
POSTGRES_DB=rag_harness
POSTGRES_USER=rag_harness
POSTGRES_PASSWORD=local_dev_password
POSTGRES_PORT=5432
TEST_POSTGRES_DB=rag_harness_test

RABBITMQ_USER=rag_harness
RABBITMQ_PASSWORD=local_dev_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_JOB_EXCHANGE=rag_harness.jobs
RABBITMQ_RETRY_EXCHANGE=rag_harness.jobs.retry
RABBITMQ_DEAD_LETTER_EXCHANGE=rag_harness.jobs.dlx
RABBITMQ_JOB_QUEUE=rag_harness.jobs
RABBITMQ_RETRY_QUEUE=rag_harness.jobs.retry
RABBITMQ_DEAD_LETTER_QUEUE=rag_harness.jobs.dlq
RABBITMQ_JOB_ROUTING_KEY=job.execute
RABBITMQ_RETRY_ROUTING_KEY=job.retry
RABBITMQ_DEAD_LETTER_ROUTING_KEY=job.dead
RABBITMQ_RETRY_DELAY_MS=5000

OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_INTERVAL_SECONDS=0.5
OUTBOX_LEASE_SECONDS=30
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_SECONDS=1
OUTBOX_RETRY_MAX_SECONDS=60
WORKER_PROCESSING_LEASE_SECONDS=900
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_SECONDS=5
WORKER_RETRY_MAX_SECONDS=300
WORKER_RECOVERY_BATCH_SIZE=20
WORKER_RECOVERY_POLL_SECONDS=2
DLQ_PUBLISH_RETRY_BASE_SECONDS=5
DLQ_PUBLISH_RETRY_MAX_SECONDS=300
ENABLE_ADMIN_RECOVERY=false

# Ollama는 무료 로컬 프로세스이며 nomic-embed-text의 출력 차원과 DB 스키마를 맞춘다.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# 답변 생성 모델은 4단계 실제 검증 전에 별도로 pull한다.
OLLAMA_GENERATION_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_GENERATION_TIMEOUT_SECONDS=120
WORKFLOW_QUESTION_MAX_CHARS=4000
WORKFLOW_MAX_QUERY_REWRITES=1
WORKFLOW_MAX_GENERATION_ATTEMPTS=2
# 기본은 완전 로컬 Ollama다. Jev 실험 시에만 jev로 바꾸고 Secret은 로컬 .env에 입력한다.
WORKFLOW_DOCUMENT_GRADER=ollama
AI_GATEWAY_API_KEY=
JEV_BASE_URL=https://ai-gateway.vercel.sh
JEV_MODEL=typesafe-ai/jev
JEV_TIMEOUT_SECONDS=15
JEV_RELEVANCE_THRESHOLD=0.7
JEV_CONFLICT_THRESHOLD=0.7
JEV_FALLBACK_TO_OLLAMA=true
# 확인된 Vercel 무료 프로모션 종료일 이후에는 외부 호출을 자동 차단한다.
JEV_FREE_USE_NOT_AFTER=2026-09-25
EMBEDDING_DIMENSIONS=768
DOCUMENT_CHUNK_MAX_CHARS=1200
DOCUMENT_CHUNK_OVERLAP_CHARS=120
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=-1.0
RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=2

API_PORT=8000
ENABLE_LOCAL_EVENTS=true
DATABASE_URL=postgresql+asyncpg://rag_harness:local_dev_password@localhost:5432/rag_harness
RABBITMQ_URL=amqp://rag_harness:local_dev_password@localhost:5672/

# 실제 Slack 값은 로컬 .env에만 입력하고 저장소에 커밋하지 않는다.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_TIMESTAMP_TOLERANCE_SECONDS=300
